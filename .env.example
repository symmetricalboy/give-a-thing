# Public URL (use http://127.0.0.1:3000 in local dev for ATProto Loopback OAuth, https://giveathing.com in prod)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# PostgreSQL with pgvector enabled (Railway Postgres pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/giveathing

# Session signing secret (generate a 32+ byte random hex string)
SESSION_SECRET=replace-with-a-secure-random-32-byte-hex-secret

# Google Gemini API Key (powers gemini-4-carbon, gemini-embedding-2, and gemini-nano-banana-2.1)
GEMINI_API_KEY=your-gemini-api-key

# Official Give a Thing ATProtocol Account / App PDS (@giveathing.com)
# Canonical com.giveathing.thing and com.giveathing.ledger records live here!
APP_ATPROTO_SERVICE=https://bsky.social
APP_ATPROTO_IDENTIFIER=giveathing.com
APP_ATPROTO_PASSWORD=your-app-pds-password
NEXT_PUBLIC_APP_ATPROTO_DID=did:plc:replace_with_app_did

# ATProtocol OAuth Private Key (ES256 JWK JSON string, optional for confidential client; omit to use public DPoP client)
ATPROTO_OAUTH_PRIVATE_JWK=

# ATProtocol Jetstream WebSocket URL (for background follow auto-import & network indexing)
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Railway S3-Compatible Bucket (optional in local dev; falls back to local /api/sprites/[cid] serving)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Stripe Connect & Checkout (for paid Mystery Box pulls & creator payouts)
# Comma-separate Connect + Platform webhook signing secrets in STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_connect_webhook_secret

{
  "lexicon": 1,
  "id": "com.giveathing.transfer",
  "defs": {
    "main": {
      "type": "record",
      "description": "User-signed gift receipt stored in the sender's PDS whenever they give a Thing away.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["thing", "to", "transferredAt"],
        "properties": {
          "thing": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "to": {
            "type": "string",
            "format": "did"
          },
          "note": {
            "type": "string",
            "maxLength": 420,
            "maxGraphemes": 140
          },
          "transferredAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
